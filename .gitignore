node_modules/
target/
dist/
src-tauri/target/
src-tauri/gen/
.env
.env.*
!.env.example
*.log
coverage/

# Local Tauri updater signing key. The private half goes into the
# GitHub Actions secret `TAURI_SIGNING_PRIVATE_KEY`; the public half
# lives in src-tauri/tauri.conf.json under plugins.updater.pubkey.
.secrets/

# Local agent / IDE workspace dirs that occasionally drop symlinks
# pointing into $HOME — they're machine-specific and never belong in
# the repo.
.antigravitycli/
.gemini/
.cursor/

# macOS Finder metadata. Never useful in version control; auto-created
# any time a directory is opened in Finder.
.DS_Store
**/.DS_Store

# Internal project-management notes live in the private companion repo
# `pravton/gitbar-internal`, not here. The entries stay listed even when
# the files are absent so a future agent's `mkdir artifacts/` or
# `touch IN_PROGRESS.md` doesn't accidentally re-introduce them to the
# public repo.
/artifacts/
/IN_PROGRESS.md
